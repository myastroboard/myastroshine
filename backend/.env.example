# MyAstroShine backend - environment.
#
# You do NOT need this file to run the app: `docker compose up` and the local
# `uvicorn` command both work with the defaults below. Copy to .env only to
# change the deployment shape.
#
# Everything else - CORS origins, AstroDex callback allowlist, upload limits,
# session lifetime, stacking defaults, log levels - is edited from Settings in
# the UI and stored in DATA_DIR/app_settings.json. The session secret is
# generated once into DATA_DIR/secret_key.txt. None of it belongs here.

# Run mode
APP_ENV=development          # development | production

# Single persistence root. Everything the app writes lives under it.
DATA_DIR=./data

# Optional database override (default: SQLite in DATA_DIR)
# DATABASE_URL=postgresql+psycopg://user:pass@host/myastroshine

# Set to false to turn the administration surface (Settings, admin API) off
# ADMIN_ENABLED=true
