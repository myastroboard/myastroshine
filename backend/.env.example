# MyAstroShine backend configuration
# Copy to .env and adjust for your environment.

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=info

# Database
DATABASE_URL=sqlite:///./data/db/myastroshine.db

# Storage
STORAGE_PATH=./data/images
MAX_IMAGE_SIZE_MB=100
SESSION_EXPIRY_HOURS=24

# API
API_TITLE=MyAstroShine
API_VERSION=0.1.0
API_PORT=8002
API_CORS_ORIGINS=http://localhost:3000,http://myastroshine.local

# AstroDex integration
# Bearer tokens are created in the UI (each has its own signing secret). This
# value is only the fallback HMAC secret when a link has no token.
ASTRODEX_WEBHOOK_SECRET=your-secret-key-here
# Comma-separated allowlist of callback hosts. Empty = allow any (dev only).
ASTRODEX_CALLBACK_URLS=http://myastroboard.local/api/webhooks/enhanced-images
ASTRODEX_MAX_RETRIES=3
ASTRODEX_RETRY_DELAY_SECONDS=5

# Redis / Celery (needed only when PROCESSING_MODE=queue)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Processing
# sync  = run the pipeline in the request (default; no worker/Redis needed)
# queue = enqueue a Celery task; progress streams over the WebSocket
PROCESSING_MODE=sync
MAX_WORKERS=4
DENOISE_ENABLE_ML=false
DEPTH_DETECTION_METHOD=gradient

# Stacking (v1.1+)
STACKING_ENABLED=true
STACKING_MAX_FRAMES=100
STACKING_DETECTOR=orb
STACKING_COMBINATION_DEFAULT=median
STACKING_COSMIC_RAY_THRESHOLD=3.0
STACKING_TEMP_DIR=./data/stacks
