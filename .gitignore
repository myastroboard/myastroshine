# Planning docrs (local only)
initial_plan/*

# ---------------------------------------------------------------------------
# Python / backend
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.manual-check*

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.local

# Playwright (e2e)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/
.e2e-tmp/
backend/.e2e-tmp/

# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
.env
*.env
!.env.example
!*.env.example

# ---------------------------------------------------------------------------
# Runtime data (images, sqlite db, caches, stacks)
# ---------------------------------------------------------------------------
data/
*.db
*.sqlite3
/tmp/
*.npy

# Operator-installed external ML engine binaries (StarNet2 / DeepSNR) - never
# bundled or committed. The directory and its README are tracked so the compose
# bind mount always has a target; anything the operator drops in is ignored.
# See docs/DEPLOYMENT.md "External ML engines".
engines/*
!engines/README.md

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
*.swp
