# The app talks to the API on its own origin (/api, /ws). The dev server and the
# production nginx both proxy those to the backend, so leave these unset unless
# the API is genuinely on a different origin.
# VITE_API_URL=https://api.example.com/api
# VITE_WS_URL=wss://api.example.com/ws

# Dev server only: where `npm run dev` proxies /api and /ws.
# VITE_PROXY_TARGET=http://localhost:8002

VITE_APP_NAME=MyAstroShine
VITE_APP_VERSION=0.1.0
